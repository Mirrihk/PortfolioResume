@page "/password"
@layout MainLayout

@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Sign In | Sebastian Alvarez</PageTitle>

<div class="page-container">
    <div class="responsive-panel auth-form-panel">

        <h1>Optional Sign In</h1>

        <p class="subtitle">
            The portfolio is public. Sign in only to access
            future account features.
        </p>

        <label for="login-email">
            Email
        </label>

        <input id="login-email"
               type="email"
               @bind="Email"
               autocomplete="email"
               placeholder="you@example.com" />

        <label for="login-password">
            Password
        </label>

        <input id="login-password"
               type="password"
               @bind="UserPassword"
               autocomplete="current-password"
               placeholder="Enter your password" />

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <p class="error" role="alert">
                @ErrorMessage
            </p>
        }

        <button type="button"
                @onclick="LoginWithEmail"
                disabled="@IsSubmitting">

            @(IsSubmitting
                ? "Signing in..."
                : "Sign in with email")
        </button>

        <p class="alt-title">
            Or use a social account
        </p>

        <button type="button"
                class="google-btn"
                @onclick="LoginWithGoogle"
                disabled="@IsSubmitting">
            Sign in with Google
        </button>

        <button type="button"
                class="github-btn"
                @onclick="LoginWithGitHub"
                disabled="@IsSubmitting">
            Sign in with GitHub
        </button>

        <div class="alt-options">
            <button type="button"
                    @onclick="GoToSignup">
                Create account
            </button>

            <button type="button"
                    @onclick="GoToPortfolio">
                Return to portfolio
            </button>
        </div>

    </div>
</div>

@code {
    private string Email { get; set; } = string.Empty;

    private string UserPassword { get; set; } = string.Empty;

    private string ErrorMessage { get; set; } = string.Empty;

    private bool IsSubmitting { get; set; }

    private void GoToSignup()
    {
        Nav.NavigateTo("/signup");
    }

    private void GoToPortfolio()
    {
        Nav.NavigateTo("/");
    }

    private async Task LoginWithEmail()
    {
        ErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(Email) ||
            string.IsNullOrWhiteSpace(UserPassword))
        {
            ErrorMessage = "Enter your email and password.";
            return;
        }

        await RunLoginAsync(
            "authProvider.loginWithEmail",
            Email.Trim(),
            UserPassword);
    }

    private async Task LoginWithGoogle()
    {
        await RunLoginAsync(
            "authProvider.loginWithGoogle");
    }

    private async Task LoginWithGitHub()
    {
        await RunLoginAsync(
            "authProvider.loginWithGitHub");
    }

    private async Task RunLoginAsync(
        string method,
        params object[] arguments)
    {
        ErrorMessage = string.Empty;
        IsSubmitting = true;

        try
        {
            FirebaseAuthResult result =
                await JS.InvokeAsync<FirebaseAuthResult>(
                    method,
                    arguments);

            if (result.Success)
            {
                Nav.NavigateTo("/", forceLoad: true);
                return;
            }

            ErrorMessage =
                string.IsNullOrWhiteSpace(result.Message)
                    ? "Sign-in failed. Please try again."
                    : result.Message;
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "Sign-in could not be completed.";

            Console.WriteLine(ex);
        }
        finally
        {
            IsSubmitting = false;
            UserPassword = string.Empty;
        }
    }

    private sealed class FirebaseAuthResult
    {
        public bool Success { get; set; }

        public string? Message { get; set; }
    }
}