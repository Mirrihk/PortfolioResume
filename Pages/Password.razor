@page "/password"
@layout MainLayout
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Sign In | Sebastian Alvarez</PageTitle>

<div class="page-container">
    <div class="responsive-panel login-layout">
        <div class="login-top">
            <h1>Optional Sign In</h1>
            <p class="subtitle">
                The portfolio is public. Sign in only to access future account features.
            </p>

            <div class="logo-wrapper">
                <img src="images/C-Bass-logo-transparent.png" alt="C-Bass logo" class="login-logo" />
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <p class="error" role="alert">@ErrorMessage</p>
            }
        </div>

        <div class="login-bottom">
            <button class="google-btn" @onclick="LoginWithGoogle">Sign in with Google</button>
            <button class="github-btn" @onclick="LoginWithGitHub">Sign in with GitHub</button>

            <div class="alt-options">
                <button class="signup-btn" @onclick="GoToSignup">Create account</button>
                <button class="guest-btn" @onclick="GoToPortfolio">Return to portfolio</button>
            </div>
        </div>
    </div>
</div>

@code {
    private string ErrorMessage { get; set; } = string.Empty;

    private void GoToSignup() => Nav.NavigateTo("/signup");
    private void GoToPortfolio() => Nav.NavigateTo("/");

    private async Task LoginWithGoogle()
    {
        await LoginAsync("authProvider.loginWithGoogle", "Google");
    }

    private async Task LoginWithGitHub()
    {
        await LoginAsync("authProvider.loginWithGitHub", "GitHub");
    }

    private async Task LoginAsync(string method, string providerName)
    {
        ErrorMessage = string.Empty;

        try
        {
            var ok = await JS.InvokeAsync<bool>(method);

            if (ok)
                Nav.NavigateTo("/", forceLoad: true);
            else
                ErrorMessage = $"{providerName} sign-in failed. Please try again.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"{providerName} sign-in could not be completed.";
            Console.WriteLine(ex);
        }
    }
}
