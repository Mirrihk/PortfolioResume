@page "/"
@layout MainLayout

<PageTitle>Sebastian Alvarez | Portfolio</PageTitle>

<div class="page-container">
    <div class="responsive-panel">
        <section class="hero-section" aria-labelledby="portfolio-title">
            <p class="hero-eyebrow">C# / .NET Developer</p>
            <h1 id="portfolio-title" class="hero-title">Sebastian Alvarez</h1>
            <p class="hero-subtitle">
                I build practical web applications, APIs, desktop tools, and mathematical visualization software.
            </p>
        </section>

        <div class="content-section">
            <h2>Developer Summary</h2>
            <p>
                Software developer with experience in C#, Blazor, Python, REST APIs, and automation,
                focused on creating reliable applications with clean, maintainable code.
            </p>
        </div>

        <div class="skills">
            <h2>Skills &amp; Expertise</h2>
            <ul class="skills">
                <li>C# &amp; .NET</li>
                <li>Python</li>
                <li>HTML &amp; CSS</li>
                <li>Azure</li>
                <li>SQL</li>
                <li>Docker, Git &amp; GitHub Actions</li>
                <li>REST APIs &amp; Web Security</li>
            </ul>
        </div>

        <div class="content-section stats-flex">
            <div class="stats-card">
                <h2>GitHub Contributions</h2>
                <a href="https://github.com/Mirrihk" target="_blank" rel="noopener noreferrer">
                    <img src="https://ghchart.rshah.org/Mirrihk"
                         alt="Sebastian Alvarez's GitHub contribution chart"
                         loading="lazy" />
                </a>
            </div>

            <div class="stats-card">
                <h2>LeetCode Stats</h2>
                <a href="https://leetcode.com/u/sebas6721" target="_blank" rel="noopener noreferrer">
                    <img src="https://leetcode-stats.vercel.app/api?username=sebas6721&amp;theme=Dark"
                         alt="Sebastian Alvarez's LeetCode statistics"
                         loading="lazy" />
                </a>
            </div>
        </div>
    </div>
</div>
